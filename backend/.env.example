# TeamFlow Backend 配置样例
# 复制为 .env 并填入你的实际值（.env 已在 .gitignore 中）

# --- For PostgreSQL Service Initialization ---
POSTGRES_DB=teamflow_db
POSTGRES_USER=teamflow_user
POSTGRES_PASSWORD=change-me-in-production

# --- For FastAPI Application ---
DATABASE_URL=postgresql://teamflow_user:change-me-in-production@db/teamflow_db

# --- For JWT ---
# 用 `python -c "import secrets; print(secrets.token_hex(32))"` 生成
SECRET_KEY=replace-with-a-secure-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- For Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- For Resend (password reset email) ---
# 留空则禁用邮件功能
RESEND_API_KEY=
