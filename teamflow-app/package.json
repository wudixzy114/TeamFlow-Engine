{
  "name": "teamflow-app",
  "version": "1.0.0",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test": "vitest",
    "test:api": "vitest tests/api_smoke_test.spec.ts",
    "test:mdns": "node debug_mdns.js"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@headlessui/vue": "^1.7.23",
    "@tresjs/cientos": "^5.1.1",
    "@tresjs/core": "^5.1.1",
    "@tresjs/post-processing": "^3.1.1",
    "@types/markdown-it": "^14.1.2",
    "@types/three": "^0.181.0",
    "@unocss/preset-wind3": "^66.5.2",
    "@unocss/transformer-directives": "^66.5.2",
    "@vueuse/core": "^14.0.0",
    "@vueuse/sound": "^2.1.3",
    "axios": "^1.12.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "d3-force-3d": "^3.0.6",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "echarts-wordcloud": "^2.1.0",
    "electron-updater": "^6.6.2",
    "flexsearch": "^0.8.212",
    "fs-extra": "^11.3.2",
    "glob": "^13.0.0",
    "gsap": "^3.13.0",
    "highlight.js": "^11.11.1",
    "ip": "^2.0.1",
    "markdown-it": "^14.1.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "mime-types": "^3.0.2",
    "multicast-dns": "^7.2.5",
    "node-llama-cpp": "^3.14.2",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "sherpa-onnx-node": "^1.12.18",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.181.2",
    "unplugin-auto-import": "^20.2.0",
    "uuid": "^13.0.0",
    "vue-echarts": "^8.0.0",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9",
    "wavefile": "^11.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@iconify-json/carbon": "^1.2.13",
    "@types/ip": "^1.1.3",
    "@types/node": "^22.18.6",
    "@unocss/preset-icons": "^66.5.2",
    "@unocss/preset-uno": "^66.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.22",
    "@vue/test-utils": "^2.4.6",
    "electron": "^38.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "eslint-plugin-vue": "^10.4.0",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.0.1",
    "msw": "^2.11.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "unocss": "^66.5.2",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.6",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.22",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "msw",
      "node-llama-cpp"
    ]
  }
}
