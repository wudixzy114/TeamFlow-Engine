{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "types": [
      "node",
      "vitest/globals",
      "vite/client",
      "electron-vite/node"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // 关键！这里必须是 bundler
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/renderer/src/*"
      ]
    }
  },
  "include": [
    "vitest.config.ts",
    "vite.config.ts",
    "src/renderer/src/**/*"
  ]
}
